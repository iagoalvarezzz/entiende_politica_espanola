{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convocatoria.schema.json",
  "title": "Convocatoria (Anexo C.1.3), fichero data/convocatorias.json",
  "description": "Ampliaciones: verificaciones (estado y fuente de cada bloque de cifras), circunscripciones_senado (las islas son circunscripciones propias del Senado) y, en cada circunscripción, nombre_boe y tipo. senadores_elegidos de una provincia insular es la suma de sus islas.",
  "type": "object",
  "required": ["id", "tipo", "fecha_votacion", "norma_id", "circunscripciones", "hitos"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "comun.schema.json#/$defs/id" },
    "tipo": { "enum": ["generales", "europeas", "autonomicas", "municipales"] },
    "fecha_votacion": { "$ref": "comun.schema.json#/$defs/fecha" },
    "norma_id": { "$ref": "comun.schema.json#/$defs/id" },
    "censo": {
      "type": "object",
      "required": ["total", "residentes_espana", "residentes_extranjero", "fecha_cierre", "fuente_id", "fecha_consulta"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "residentes_espana": { "type": "integer", "minimum": 0 },
        "residentes_extranjero": { "type": "integer", "minimum": 0 },
        "primera_vez": { "type": "integer", "minimum": 0 },
        "fecha_cierre": { "$ref": "comun.schema.json#/$defs/fecha" },
        "fuente_id": { "$ref": "comun.schema.json#/$defs/id" },
        "fecha_consulta": { "$ref": "comun.schema.json#/$defs/fecha" }
      }
    },
    "verificaciones": { "type": "array", "items": { "$ref": "comun.schema.json#/$defs/verificacion" } },
    "circunscripciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nombre", "escanos_congreso", "senadores_elegidos"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "comun.schema.json#/$defs/id" },
          "nombre": { "$ref": "comun.schema.json#/$defs/texto" },
          "nombre_boe": { "$ref": "comun.schema.json#/$defs/texto" },
          "tipo": { "enum": ["provincia", "ciudad_autonoma"] },
          "escanos_congreso": { "type": "integer", "minimum": 1 },
          "senadores_elegidos": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "circunscripciones_senado": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nombre", "provincia_id", "tipo", "senadores_elegidos"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "comun.schema.json#/$defs/id" },
          "nombre": { "$ref": "comun.schema.json#/$defs/texto" },
          "provincia_id": { "$ref": "comun.schema.json#/$defs/id" },
          "tipo": { "enum": ["provincia", "isla", "ciudad_autonoma"] },
          "senadores_elegidos": { "type": "integer", "minimum": 1 },
          "max_marcas": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "hitos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nombre", "desde", "fuente_id", "estado"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "comun.schema.json#/$defs/id" },
          "nombre": { "$ref": "comun.schema.json#/$defs/texto" },
          "desde": { "$ref": "comun.schema.json#/$defs/fecha" },
          "hasta": { "$ref": "comun.schema.json#/$defs/fecha" },
          "hora": { "type": "string" },
          "fuente_id": { "$ref": "comun.schema.json#/$defs/id" },
          "estado": { "enum": ["verificado", "pendiente"] },
          "nota": { "type": "string" }
        }
      }
    }
  }
}
